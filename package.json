{
  "name": "trpc-to-mcp",
  "license": "MIT",
  "version": "2.0.0",
  "description": "Turn tRPC procedures into MCP tools",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "keywords": [
    "trpc",
    "mcp",
    "modelcontextprotocol",
    "mcp-handler"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release": "pnpm run build && changeset publish"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iboughtbed/trpc-to-mcp.git"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./adapters/vercel-mcp-adapter": {
      "import": "./dist/adapters/vercel-mcp-adapter.mjs",
      "require": "./dist/adapters/vercel-mcp-adapter.cjs"
    },
    "./helpers": {
      "import": "./dist/helpers.mjs",
      "require": "./dist/helpers.cjs"
    },
    "./server": {
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    },
    "./tools": {
      "import": "./dist/tools.mjs",
      "require": "./dist/tools.cjs"
    },
    "./types": {
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@trpc/server": "^11.19.0",
    "@types/node": "^24.13.6",
    "mcp-handler": "^2.2.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@trpc/server": "^11.0.0",
    "mcp-handler": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "mcp-handler": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0"
}
